    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.20.0",
    "mux-embed": "^5.18.1",
    "postcss": "^8.5.15",
