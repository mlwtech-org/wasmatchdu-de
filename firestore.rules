rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminEmail(email) {
      return email == 'anilkumaraero@gmail.com' || 
             email == 'anilkumardeu@gmail.com' || 
             email == 'bobkiowsky@gmail.com';
    }

    // Secure user profiles
    match /users/{userId} {
      // A user can read their own document. Admins can read all users for telemetry counts.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdminEmail(request.auth.token.email));
      
      // Creating a new user document is allowed if they set role to 'user', 
      // or if they are an admin email they can set 'admin'.
      allow create: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.role == 'user' || 
        (isAdminEmail(request.auth.token.email) && request.resource.data.role == 'admin')
      );
      
      // Updating a document is allowed as long as they don't change 'role' or 'isPremium',
      // unless they are one of the hardcoded admin emails.
      allow update: if request.auth != null && request.auth.uid == userId && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium'])) || 
        isAdminEmail(request.auth.token.email)
      );
    }
    
    // Moderation and Banned Streams Collections
    match /moderation_queue/{docId} {
      // Users can create reports, but only admins can read/update/delete them.
      allow create: if request.auth != null;
      allow read, write: if request.auth != null && isAdminEmail(request.auth.token.email);
    }
    
    match /banned_streams/{docId} {
      // Anyone can read banned streams so the client can filter them out
      allow read: if true;
      // Only admins can write to banned streams
      allow write: if request.auth != null && isAdminEmail(request.auth.token.email);
    }

    match /telemetry/{docId} {
      // General telemetry rules
      allow read: if request.auth != null && isAdminEmail(request.auth.token.email);
      allow write: if request.auth != null && isAdminEmail(request.auth.token.email);
    }

    match /system_logs/{docId} {
      allow read, write: if request.auth != null && isAdminEmail(request.auth.token.email);
    }

    match /algorithm_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdminEmail(request.auth.token.email);
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
